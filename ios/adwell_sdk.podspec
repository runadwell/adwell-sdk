# CocoaPods builds use a copy of AdwellSDK in vendor/, generated by
# tool/sync_ios.sh from an adwell-ios tag (ADR 0002 D9). Never edit the copy.
Pod::Spec.new do |s|
  s.name             = 'adwell_sdk'
  s.version          = '0.1.0'
  s.summary          = 'Adwell SDK for Flutter.'
  s.description      = 'Links Apple Ads installs to subscription revenue. Bridge over AdwellSDK.'
  s.homepage         = 'https://runadwell.com'
  s.license          = { :file => '../LICENSE' }
  s.author           = 'Adwell'
  s.source           = { :path => '.' }
  s.source_files     = 'adwell_sdk/Sources/adwell_sdk/**/*.swift', 'vendor/AdwellSDK/**/*.swift'
  s.resource_bundles = { 'adwell_sdk_privacy' => ['vendor/AdwellSDK/PrivacyInfo.xcprivacy'] }
  s.dependency 'Flutter'
  s.platform = :ios, '14.0'
  s.pod_target_xcconfig = { 'DEFINES_MODULE' => 'YES', 'EXCLUDED_ARCHS[sdk=iphonesimulator*]' => 'i386' }
  s.swift_version = '5.9'
end
